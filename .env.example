# ============================================
# WhatsApp Configuration
# ============================================

# ID del número de teléfono en Meta
# Obtener en: Meta for Developers > WhatsApp > Settings > Phone Numbers
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id_aqui"

# Token de acceso para la API de WhatsApp
# Obtener en: Meta for Developers > Settings > User Access Tokens
# o generar en: WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN="tu_access_token_aqui"

# Token de verificación para el webhook
# Puedes generar cualquier string seguro, ej: $(openssl rand -hex 16)
# Configurar en: Meta for Developers > WhatsApp > Configuration > Verify Token
WHATSAPP_VERIFY_TOKEN="tu_verify_token_aqui"

# App Secret para validar firmas de Meta (opcional pero recomendado)
# Obtener en: Meta for Developers > Settings > Basic > App Secret
# Si no está configurado, la validación de firma se salta en desarrollo
WHATSAPP_APP_SECRET="tu_app_secret_aqui"
